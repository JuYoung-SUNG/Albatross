@namespace Albatross.Web
@inject IJSRuntime JS

<nav class="topnav">
    <div class="brand">⚾ Albatross KBO</div>
    <div class="nav-links">
        <NavLink href="" Match="NavLinkMatch.All">홈</NavLink>
        <NavLink href="kbo">KBO</NavLink>
        <NavLink href="games">날짜별 경기</NavLink>
        <NavLink href="players">선수 기록</NavLink>
        <NavLink href="standings">팀 순위</NavLink>
        <div class="theme-switch">
            @foreach (var theme in Themes)
            {
                <button data-swatch="@theme"
                        class="@(theme == _currentTheme ? "active" : "")"
                        title="@ThemeLabel(theme)"
                        @onclick="() => SetTheme(theme)"></button>
            }
        </div>
    </div>
</nav>

@code {
    private static readonly string[] Themes = ["white", "blue", "yellow", "green"];
    private string _currentTheme = "white";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _currentTheme = await JS.InvokeAsync<string>("albatrossTheme.get");
            StateHasChanged();
        }
    }

    private async Task SetTheme(string theme)
    {
        _currentTheme = theme;
        await JS.InvokeVoidAsync("albatrossTheme.set", theme);
    }

    private static string ThemeLabel(string theme) => theme switch
    {
        "white" => "화이트",
        "blue" => "블루",
        "yellow" => "옐로",
        "green" => "그린",
        _ => theme
    };
}
