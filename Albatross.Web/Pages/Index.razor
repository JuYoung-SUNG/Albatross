@page "/"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Logging
@inject ILogger<Index> Logger
@inject HttpClient Http

<PageTitle>Albatross 뉴스</PageTitle>

<div class="app-container @(_darkMode ? "dark-mode" : "light-mode")">
    <div class="hero">
        <div class="header-top">
            <h1>🦅 Albatross News</h1>
            <div class="controls">
                <button class="theme-toggle" @onclick="() => _darkMode = !_darkMode">
                    @(_darkMode ? "🌞 Light" : "🌙 Dark")
                </button>
            </div>
        </div>
        <p class="subtitle">실시간 전 세계 주요 이슈</p>
        
        <div class="category-tabs">
            @foreach (var cat in _categories)
            {
                <button class="@(_selectedCategory == cat ? "active" : "")" @onclick="() => SelectCategory(cat)">
                    @cat
                </button>
            }
        </div>
    </div>

    <div class="content-area">
        @if (_loading)
        {
            <div class="loading">
                <div class="spinner"></div>
                <p>뉴스를 불러오는 중...</p>
            </div>
        }
        else if (_error is not null)
        {
            <div class="error-box">⚠️ @_error</div>
        }
        else if (_items is null || !_items.Any())
        {
            <div class="empty">수집된 뉴스가 없습니다. Collector를 먼저 실행해 주세요.</div>
        }
        else
        {
            <div class="news-grid">
                @foreach (var item in _filteredItems)
                {
                    var clusterId = item.Id;
                    var bgImageUrl = !string.IsNullOrEmpty(item.ImageUrl) 
                                     ? item.ImageUrl 
                                     : $"https://picsum.photos/seed/{clusterId.GetHashCode()}/800/400";

                    <div class="news-cluster">
                        <div class="news-card-content">
                            <!-- CATEGORY -->
                            <div class="category-badge">@item.Category</div>

                            <!-- TITLE -->
                            <h4 class="cluster-title">
                                @item.Title
                            </h4>

                            <!-- IMAGE -->
                            <div class="chapter-image" style="background-image: url('@bgImageUrl');"></div>

                            <!-- CONTENT -->
                            <p class="short-summary">
                                @item.Content
                            </p>

                            <div class="card-meta">
                                <span class="time">@item.PublishedAt</span>
                            </div>
                        </div>

                        <!-- LINK -->
                        @if (item.RelatedUrls != null && item.RelatedUrls.Any())
                        {
                            <button class="related-toggle" @onclick="() => ToggleRelated(clusterId)">
                                🔗 관련 기사 @(item.RelatedUrls.Count) 건 @(_expandedRelated.Contains(clusterId) ? "접기 ▲" : "보기 ▼")
                            </button>
                            
                            @if (_expandedRelated.Contains(clusterId))
                            {
                                <div class="related-list">
                                    @foreach (var url in item.RelatedUrls)
                                    {
                                        <a href="@url" target="_blank" class="related-item">
                                            <span class="related-title">@url</span>
                                        </a>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    :root {
        --bg-color: #f8f9fa;
        --text-color: #333;
        --card-bg: white;
        --hero-bg: #fff;
        --border-color: #eee;
        --shadow: 0 4px 6px rgba(0,0,0,0.05);
        --accent: #007bff;
    }

    .dark-mode {
        --bg-color: #121212;
        --text-color: #e0e0e0;
        --card-bg: #1e1e1e;
        --hero-bg: #181818;
        --border-color: #333;
        --shadow: 0 4px 10px rgba(0,0,0,0.3);
    }

    .app-container { 
        min-height: 100vh; 
        background-color: var(--bg-color); 
        color: var(--text-color); 
        transition: background-color 0.3s, color 0.3s;
        padding-bottom: 3rem;
    }

    .hero { 
        background-color: var(--hero-bg); 
        padding: 2rem 5%; 
        border-bottom: 1px solid var(--border-color);
        margin-bottom: 2rem;
        text-align: center;
    }

    .header-top { display: flex; justify-content: space-between; align-items: center; }
    
    .theme-toggle {
        padding: 0.5rem 1rem;
        border-radius: 20px;
        border: 1px solid var(--border-color);
        background: var(--card-bg);
        color: var(--text-color);
        cursor: pointer;
        font-weight: bold;
    }

    .category-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1.5rem;
        justify-content: center;
    }
    .category-tabs button {
        padding: 0.4rem 1rem;
        border: 1px solid var(--border-color);
        border-radius: 20px;
        background: var(--card-bg);
        color: var(--text-color);
        cursor: pointer;
        font-size: 0.9rem;
        transition: all 0.2s;
    }
    .category-tabs button.active {
        background: var(--accent);
        color: white;
        border-color: var(--accent);
    }

    .content-area { padding: 0 5%; }

    .news-grid { 
        display: grid; 
        grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
        gap: 2rem; 
        max-width: 1200px;
        margin: 0 auto;
    }

    @@media (max-width: 850px) {
        .news-grid {
            grid-template-columns: 1fr;
        }
    }

    .news-cluster {
        display: flex;
        flex-direction: column;
        background: var(--card-bg);
        border-radius: 12px;
        box-shadow: var(--shadow);
        border: 1px solid var(--border-color);
        overflow: hidden;
        transition: transform 0.2s;
    }
    .news-cluster:hover { transform: translateY(-5px); }

    .news-card-content {
        padding: 1.5rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .category-badge {
        font-size: 0.75rem;
        color: var(--accent);
        font-weight: bold;
        margin-bottom: 0.5rem;
        text-transform: uppercase;
    }

    .cluster-title {
        font-size: 1.2rem;
        font-weight: bold;
        color: var(--text-color);
        margin-bottom: 1rem;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 3.4rem;
    }

    .chapter-image {
        width: 100%;
        height: 220px;
        background-size: cover;
        background-position: center;
        border-radius: 8px;
        margin-bottom: 1rem;
    }

    .short-summary {
        font-size: 0.95rem;
        color: var(--text-color);
        opacity: 0.8;
        margin-bottom: 1rem;
        line-height: 1.6;
    }

    .card-meta { 
        display: flex; 
        justify-content: space-between;
        align-items: center; 
        font-size: 0.8rem; 
        opacity: 0.7;
        margin-top: auto;
    }

    .related-toggle {
        background: var(--bg-color);
        border: none;
        border-top: 1px solid var(--border-color);
        padding: 0.8rem;
        width: 100%;
        text-align: center;
        color: var(--accent);
        font-weight: bold;
        cursor: pointer;
    }

    .related-list {
        background: rgba(0,0,0,0.02);
        max-height: 300px;
        overflow-y: auto;
    }
    .dark-mode .related-list { background: rgba(255,255,255,0.02); }

    .related-item {
        padding: 0.6rem 1rem;
        text-decoration: none;
        color: var(--text-color);
        font-size: 0.85rem;
        border-bottom: 1px solid var(--border-color);
        display: block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .related-item:hover { background: rgba(0,0,0,0.05); }

    .loading, .empty, .error-box { text-align: center; padding: 4rem; font-size: 1.2rem; }
</style>

@code {
    private bool _darkMode = false;
    private HashSet<string> _expandedRelated = new();
    private bool _loading = true;
    private string? _error;
    private List<NewsDto>? _items;
    private List<NewsDto> _filteredItems = new();
    private string _selectedCategory = "전체";
    private readonly string[] _categories = { "전체", "정치", "사회", "경제", "스포츠", "연예", "IT", "일반" };

    protected override void OnInitialized()
    {
        Logger.LogInformation("Index.razor initialized.");
    }

    private void SelectCategory(string category)
    {
        _selectedCategory = category;
        FilterItems();
    }

    private void FilterItems()
    {
        if (_items == null) return;

        _filteredItems = _selectedCategory == "전체" 
            ? _items 
            : _items.Where(i => i.Category == _selectedCategory).ToList();
        
        _filteredItems = _filteredItems.OrderByDescending(i => i.PublishedAt).ToList();
    }

    private void ToggleRelated(string clusterId)
    {
        if (_expandedRelated.Contains(clusterId))
            _expandedRelated.Remove(clusterId);
        else
            _expandedRelated.Add(clusterId);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _items = await Http.GetFromJsonAsync<List<NewsDto>>("data/news.json");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _items = GetSampleData();
        }
        finally
        {
            FilterItems();
            _loading = false;
        }
    }

    private List<NewsDto> GetSampleData() =>
    [
        new NewsDto("1", "한국 기술 혁신 소식", "한국의 IT 산업이 글로벌 시장에서 주목받고 있습니다. AI와 반도체 분야에서의 성과가 두드러집니다.", "https://picsum.photos/seed/1/800/400", "IT", "2026-05-22 10:00:00", new List<string> { "https://example.com/1" }),
        new NewsDto("2", "경제 지표 발표", "주요 경제 지표가 발표되었습니다. 인플레이션 둔화 조짐이 보이며 시장은 긍정적으로 반응하고 있습니다.", "https://picsum.photos/seed/2/800/400", "경제", "2026-05-22 09:30:00", new List<string> { "https://example.com/2" })
    ];

    private record NewsDto(
        string Id,
        string Title,
        string Content,
        string? ImageUrl,
        string Category,
        string PublishedAt,
        List<string> RelatedUrls);
}
