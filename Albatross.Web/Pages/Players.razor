@page "/players"
@using System.Net.Http.Json
@using Albatross.Shared.Models
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Albatross KBO - 선수 기록</PageTitle>

<KboNav />

<h1 style="margin-bottom:1rem;">선수 기록</h1>

<div class="tab-row">
    <button class="@(_tab == Tab.Batter ? "active" : "")" @onclick="() => SwitchTab(Tab.Batter)">타자</button>
    <button class="@(_tab == Tab.Pitcher ? "active" : "")" @onclick="() => SwitchTab(Tab.Pitcher)">투수</button>
</div>

@if (!_loading && _error is null)
{
    <div class="tab-row tab-row--sub">
        @foreach (var m in _tab == Tab.Batter ? BatterMetrics : PitcherMetrics)
        {
            <button class="@(m == CurrentMetric ? "active" : "")" @onclick="() => SwitchMetric(m)">@MetricLabel(m)</button>
        }
    </div>

    @if (_trends is { Dates.Count: > 0 })
    {
        <div class="range-picker">
            <label>
                시작일
                <input type="date" min="@IsoDate(_minDate)" max="@IsoDate(_maxDate)" value="@IsoDate(_rangeStart)" @onchange="OnRangeStartChanged" />
            </label>
            <label>
                종료일
                <input type="date" min="@IsoDate(_minDate)" max="@IsoDate(_maxDate)" value="@IsoDate(_rangeEnd)" @onchange="OnRangeEndChanged" />
            </label>
            <button class="range-reset" @onclick="ResetRange">최근 15일</button>
        </div>
    }
}

@if (_loading)
{
    <div class="loading"><div class="spinner"></div><p>불러오는 중...</p></div>
}
else if (_error is not null)
{
    <div class="error-box">데이터를 불러오지 못했습니다: @_error</div>
}
else if (_tab == Tab.Batter)
{
    <div class="panel chart-wrap chart-wrap--tall">
        <canvas id="playerChart"></canvas>
    </div>
    <p class="chart-note">@ChartNote</p>
    <table class="data-table">
        <thead>
            <tr>
                <th>선수</th><th>팀</th>
                @foreach (var m in BatterMetrics)
                {
                    <th class="@(m == CurrentMetric ? "col-active" : "")">@MetricLabel(m)</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var b in _stats!.Batters.OrderByDescending(x => BatterSortValue(x, CurrentMetric)))
            {
                <tr>
                    <td>@b.PlayerName</td><td>@b.Team</td>
                    @foreach (var m in BatterMetrics)
                    {
                        <td class="num @(m == CurrentMetric ? "col-active" : "")">@FormatBatterValue(b, m)</td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="panel chart-wrap chart-wrap--tall">
        <canvas id="playerChart"></canvas>
    </div>
    <p class="chart-note">@ChartNote</p>
    <table class="data-table">
        <thead>
            <tr>
                <th>선수</th><th>팀</th>
                @foreach (var m in PitcherMetrics)
                {
                    <th class="@(m == CurrentMetric ? "col-active" : "")">@MetricLabel(m)</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var p in SortedPitchers())
            {
                <tr>
                    <td>@p.PlayerName</td><td>@p.Team</td>
                    @foreach (var m in PitcherMetrics)
                    {
                        <td class="num @(m == CurrentMetric ? "col-active" : "")">@FormatPitcherValue(p, m)</td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private enum Tab { Batter, Pitcher }

    // "Strikeouts"는 투수 탈삼진 키로 이미 쓰여서 타자 삼진은 "BatterStrikeouts"로 구분한다
    private static readonly string[] BatterMetrics =
        ["Games", "AtBats", "Hits", "HomeRuns", "Doubles", "Triples", "Rbi", "Runs", "StolenBases", "Walks", "Hbp", "BatterStrikeouts", "Obp", "Avg"];
    // 배터 쪽 키와 겹치는 지표(경기/피안타/피홈런/실점/볼넷/사구)는 Pitcher- 접두어로 구분한다
    private static readonly string[] PitcherMetrics =
        ["Era", "PitcherGames", "Wins", "Losses", "Saves", "Holds", "Innings", "Strikeouts",
         "PitcherHits", "PitcherHomeRuns", "PitcherRuns", "EarnedRuns", "PitcherWalks", "PitcherHbp", "WinRate", "Oavg"];

    private const int DefaultRangeDays = 15;

    private KboPlayerStatsDto? _stats;
    private KboPlayerTrendsDto? _trends;
    private bool _loading = true;
    private string? _error;
    private Tab _tab = Tab.Batter;
    private string _batterMetric = "HomeRuns";
    private string _pitcherMetric = "Strikeouts";
    private string? _chartRenderedFor;

    private DateOnly _minDate;
    private DateOnly _maxDate;
    private DateOnly _rangeStart;
    private DateOnly _rangeEnd;

    private string CurrentMetric => _tab == Tab.Batter ? _batterMetric : _pitcherMetric;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var statsTask = Http.GetFromJsonAsync<KboPlayerStatsDto>("data/kbo-players.json");
            var trendsTask = Http.GetFromJsonAsync<KboPlayerTrendsDto>("data/kbo-player-trends.json");
            await Task.WhenAll(statsTask, trendsTask);
            _stats = statsTask.Result;
            _trends = trendsTask.Result;

            if (_trends is { Dates.Count: > 0 })
            {
                _minDate = DateOnly.Parse(_trends.Dates[0]);
                _maxDate = DateOnly.Parse(_trends.Dates[^1]);
                ResetRange();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void SwitchTab(Tab tab) => _tab = tab;
    private void SwitchMetric(string metric)
    {
        if (_tab == Tab.Batter) _batterMetric = metric;
        else _pitcherMetric = metric;
    }

    private void ResetRange()
    {
        _rangeEnd = _maxDate;
        var earliest = _rangeEnd.AddDays(-(DefaultRangeDays - 1));
        _rangeStart = earliest < _minDate ? _minDate : earliest;
    }

    private void OnRangeStartChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var d))
        {
            _rangeStart = d < _minDate ? _minDate : d;
            if (_rangeStart > _rangeEnd) _rangeEnd = _rangeStart;
        }
    }

    private void OnRangeEndChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var d))
        {
            _rangeEnd = d > _maxDate ? _maxDate : d;
            if (_rangeEnd < _rangeStart) _rangeStart = _rangeEnd;
        }
    }

    private List<int> RangeIndexes() => _trends is null
        ? new()
        : _trends.Dates
            .Select((date, i) => (date, i))
            .Where(x => DateOnly.TryParse(x.date, out var d) && d >= _rangeStart && d <= _rangeEnd)
            .Select(x => x.i)
            .ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var renderKey = $"{_tab}|{CurrentMetric}|{_rangeStart}|{_rangeEnd}";
        if (_trends is null || _chartRenderedFor == renderKey) return;
        _chartRenderedFor = renderKey;

        var series = GetSeries(CurrentMetric);
        // 경기가 없는 날(월요일/우천취소)은 스냅샷이 없어 전원 null — 그런 날짜는 x축에서 아예 제외한다
        var indexes = RangeIndexes()
            .Where(i => series.Any(s => i < s.Values.Count && s.Values[i] is not null))
            .ToList();
        var labels = indexes.Select(i => FormatDate(_trends.Dates[i])).ToArray();

        var datasets = series.Select(s => new
        {
            label = string.IsNullOrEmpty(s.Team) ? s.PlayerName : $"{s.PlayerName} ({s.Team})",
            data = indexes.Select(i => s.Values[i]).ToArray()
        }).ToArray();

        await JS.InvokeVoidAsync("albatrossCharts.renderLine", "playerChart", labels, datasets);
    }

    private List<KboMetricTrendDto> GetSeries(string key) => key switch
    {
        "HomeRuns" => _trends!.BatterHomeRuns,
        "Avg" => _trends!.BatterAvg,
        "Hits" => _trends!.BatterHits,
        "Rbi" => _trends!.BatterRbi,
        "Obp" => _trends!.BatterObp,
        "Games" => _trends!.BatterGames,
        "AtBats" => _trends!.BatterAtBats,
        "Runs" => _trends!.BatterRuns,
        "Doubles" => _trends!.BatterDoubles,
        "Triples" => _trends!.BatterTriples,
        "StolenBases" => _trends!.BatterStolenBases,
        "Walks" => _trends!.BatterWalks,
        "Hbp" => _trends!.BatterHbp,
        "BatterStrikeouts" => _trends!.BatterStrikeouts,
        "Strikeouts" => _trends!.PitcherStrikeouts,
        "Era" => _trends!.PitcherEra,
        "Oavg" => _trends!.PitcherOavg,
        "PitcherGames" => _trends!.PitcherGames,
        "Wins" => _trends!.PitcherWins,
        "Losses" => _trends!.PitcherLosses,
        "Saves" => _trends!.PitcherSaves,
        "Holds" => _trends!.PitcherHolds,
        "Innings" => _trends!.PitcherInnings,
        "PitcherHits" => _trends!.PitcherHitsAllowed,
        "PitcherHomeRuns" => _trends!.PitcherHomeRunsAllowed,
        "PitcherRuns" => _trends!.PitcherRunsAllowed,
        "EarnedRuns" => _trends!.PitcherEarnedRuns,
        "PitcherWalks" => _trends!.PitcherWalks,
        "PitcherHbp" => _trends!.PitcherHbp,
        "WinRate" => _trends!.PitcherWinRate,
        _ => new()
    };

    private static string MetricLabel(string key) => key switch
    {
        "HomeRuns" => "홈런",
        "Avg" => "타율",
        "Hits" => "안타",
        "Rbi" => "타점",
        "Obp" => "출루율",
        "Games" => "경기",
        "AtBats" => "타수",
        "Runs" => "득점",
        "Doubles" => "2루타",
        "Triples" => "3루타",
        "StolenBases" => "도루",
        "Walks" => "볼넷",
        "Hbp" => "사구",
        "BatterStrikeouts" => "삼진",
        "Strikeouts" => "탈삼진",
        "Era" => "방어율",
        "Oavg" => "피안타율",
        "PitcherGames" => "경기",
        "Wins" => "승",
        "Losses" => "패",
        "Saves" => "세이브",
        "Holds" => "홀드",
        "Innings" => "이닝",
        "PitcherHits" => "피안타",
        "PitcherHomeRuns" => "피홈런",
        "PitcherRuns" => "실점",
        "EarnedRuns" => "자책점",
        "PitcherWalks" => "볼넷",
        "PitcherHbp" => "사구",
        "WinRate" => "승률",
        _ => key
    };

    private static bool IsLowerBetter(string key) => key is "Era" or "Oavg";

    private string ChartNote
    {
        get
        {
            var range = $"{_rangeStart:MM/dd}~{_rangeEnd:MM/dd}";
            return IsLowerBetter(CurrentMetric)
                ? $"{range} {MetricLabel(CurrentMetric)} 우수 15명(낮을수록 좋음)의 날짜별 추이"
                : $"{range} {MetricLabel(CurrentMetric)} 1~15위 선수의 날짜별 추이";
        }
    }

    private static string FormatDate(string isoDate) =>
        DateOnly.TryParse(isoDate, out var d) ? d.ToString("MM/dd") : isoDate;

    // 아래 표를 현재 선택된 탭 지표 기준으로 내림차순 정렬하기 위한 값 추출 (null은 맨 뒤로)
    private static double BatterSortValue(KboBatterStatDto b, string key) => key switch
    {
        "Games" => b.Games ?? -1,
        "AtBats" => b.AtBats ?? -1,
        "Hits" => b.Hits ?? -1,
        "HomeRuns" => b.HomeRuns ?? -1,
        "Doubles" => b.Doubles ?? -1,
        "Triples" => b.Triples ?? -1,
        "Rbi" => b.Rbi ?? -1,
        "Runs" => b.Runs ?? -1,
        "StolenBases" => b.StolenBases ?? -1,
        "Walks" => b.Walks ?? -1,
        "Hbp" => b.Hbp ?? -1,
        "BatterStrikeouts" => b.Strikeouts ?? -1,
        "Obp" => b.Obp ?? -1,
        "Avg" => b.Avg ?? -1,
        _ => b.HomeRuns ?? -1
    };

    // 방어율/피안타율은 낮을수록 좋으므로 오름차순, 나머지는 내림차순으로 정렬한다 (값 없는 행은 항상 맨 뒤)
    private IEnumerable<KboPitcherStatDto> SortedPitchers()
    {
        var key = CurrentMetric;
        return IsLowerBetter(key)
            ? _stats!.Pitchers.OrderBy(x => PitcherSortValue(x, key))
            : _stats!.Pitchers.OrderByDescending(x => PitcherSortValue(x, key));
    }

    private static double PitcherSortValue(KboPitcherStatDto p, string key) => key switch
    {
        "Era" => p.Era ?? double.MaxValue,
        "PitcherGames" => p.Games ?? -1,
        "Wins" => p.Wins ?? -1,
        "Losses" => p.Losses ?? -1,
        "Saves" => p.Saves ?? -1,
        "Holds" => p.Holds ?? -1,
        "Innings" => p.InningsDecimal ?? -1,
        "Strikeouts" => p.Strikeouts ?? -1,
        "PitcherHits" => p.HitsAllowed ?? -1,
        "PitcherHomeRuns" => p.HomeRunsAllowed ?? -1,
        "PitcherRuns" => p.RunsAllowed ?? -1,
        "EarnedRuns" => p.EarnedRuns ?? -1,
        "PitcherWalks" => p.Walks ?? -1,
        "PitcherHbp" => p.Hbp ?? -1,
        "WinRate" => p.WinRate ?? -1,
        "Oavg" => p.Oavg ?? double.MaxValue,
        _ => p.Strikeouts ?? -1
    };

    private static string FormatPitcherValue(KboPitcherStatDto p, string key) => key switch
    {
        "Era" => p.Era?.ToString("0.00") ?? "-",
        "PitcherGames" => p.Games?.ToString() ?? "-",
        "Wins" => p.Wins?.ToString() ?? "-",
        "Losses" => p.Losses?.ToString() ?? "-",
        "Saves" => p.Saves?.ToString() ?? "-",
        "Holds" => p.Holds?.ToString() ?? "-",
        "Innings" => p.Innings ?? "-",
        "Strikeouts" => p.Strikeouts?.ToString() ?? "-",
        "PitcherHits" => p.HitsAllowed?.ToString() ?? "-",
        "PitcherHomeRuns" => p.HomeRunsAllowed?.ToString() ?? "-",
        "PitcherRuns" => p.RunsAllowed?.ToString() ?? "-",
        "EarnedRuns" => p.EarnedRuns?.ToString() ?? "-",
        "PitcherWalks" => p.Walks?.ToString() ?? "-",
        "PitcherHbp" => p.Hbp?.ToString() ?? "-",
        "WinRate" => p.WinRate?.ToString("0.000") ?? "-",
        "Oavg" => p.Oavg?.ToString("0.000") ?? "-",
        _ => "-"
    };

    private static string FormatBatterValue(KboBatterStatDto b, string key) => key switch
    {
        "Games" => b.Games?.ToString() ?? "-",
        "AtBats" => b.AtBats?.ToString() ?? "-",
        "Hits" => b.Hits?.ToString() ?? "-",
        "HomeRuns" => b.HomeRuns?.ToString() ?? "-",
        "Doubles" => b.Doubles?.ToString() ?? "-",
        "Triples" => b.Triples?.ToString() ?? "-",
        "Rbi" => b.Rbi?.ToString() ?? "-",
        "Runs" => b.Runs?.ToString() ?? "-",
        "StolenBases" => b.StolenBases?.ToString() ?? "-",
        "Walks" => b.Walks?.ToString() ?? "-",
        "Hbp" => b.Hbp?.ToString() ?? "-",
        "BatterStrikeouts" => b.Strikeouts?.ToString() ?? "-",
        "Obp" => b.Obp?.ToString("0.000") ?? "-",
        "Avg" => b.Avg?.ToString("0.000") ?? "-",
        _ => "-"
    };

    // <input type="date">의 value/min/max는 로캘과 무관하게 항상 "yyyy-MM-dd" 형식이어야 한다.
    private static string IsoDate(DateOnly d) => d.ToString("yyyy-MM-dd");
}
