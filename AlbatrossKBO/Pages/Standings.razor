@page "/standings"
@using System.Net.Http.Json
@using Albatross.Shared.Models
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Albatross KBO - 팀 순위</PageTitle>


<h1 style="margin-bottom:1rem;">팀 순위</h1>

@if (!_loading && _error is null && _standings is { Count: > 0 })
{
    <div class="tab-row tab-row--sub">
        @foreach (var m in Metrics)
        {
            <button class="@(m == _metric ? "active" : "")" @onclick="() => SwitchMetric(m)">@MetricLabel(m)</button>
        }
    </div>

    @if (_trends is { Dates.Count: > 0 })
    {
        <div class="range-picker">
            <label>
                시작일
                <input type="date" min="@IsoDate(_minDate)" max="@IsoDate(_maxDate)" value="@IsoDate(_rangeStart)" @onchange="OnRangeStartChanged" />
            </label>
            <label>
                종료일
                <input type="date" min="@IsoDate(_minDate)" max="@IsoDate(_maxDate)" value="@IsoDate(_rangeEnd)" @onchange="OnRangeEndChanged" />
            </label>
            <button class="range-reset" @onclick="ResetRange">최근 15일</button>
        </div>
    }
}

@if (_loading)
{
    <div class="loading"><div class="spinner"></div><p>불러오는 중...</p></div>
}
else if (_error is not null)
{
    <div class="error-box">데이터를 불러오지 못했습니다: @_error</div>
}
else if (_standings is { Count: 0 })
{
    <div class="empty">아직 수집된 팀 순위 데이터가 없습니다.</div>
}
else
{
    <div class="panel chart-wrap chart-wrap--tall">
        <canvas id="standingsChart"></canvas>
    </div>
    <p class="chart-note">@ChartNote</p>

    <table class="data-table">
        <thead>
            <tr>
                <th>순위</th><th>팀</th><th>경기</th><th>승</th><th>패</th><th>무</th>
                <th>승률</th><th>게임차</th><th>팀타율</th><th>팀출루율</th><th>팀방어율</th><th>팀피안타율</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var team in _standings!.OrderBy(t => t.Rank))
            {
                <tr>
                    <td>@team.Rank</td>
                    <td>@team.TeamName</td>
                    <td class="num">@team.Games</td>
                    <td class="num">@team.Wins</td>
                    <td class="num">@team.Losses</td>
                    <td class="num">@team.Draws</td>
                    <td class="num">@team.WinRate?.ToString("0.000")</td>
                    <td class="num">@team.GamesBehind</td>
                    <td class="num">@team.Avg?.ToString("0.000")</td>
                    <td class="num">@team.Obp?.ToString("0.000")</td>
                    <td class="num">@team.Era?.ToString("0.00")</td>
                    <td class="num">@team.Oavg?.ToString("0.000")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private static readonly string[] Metrics = ["WinRate", "Avg", "Obp", "Era", "Oavg"];

    private const int DefaultRangeDays = 15;

    private List<KboStandingDto>? _standings;
    private KboTeamTrendsDto? _trends;
    private bool _loading = true;
    private string? _error;
    private string _metric = "WinRate";
    private string? _chartRenderedFor;

    private DateOnly _minDate;
    private DateOnly _maxDate;
    private DateOnly _rangeStart;
    private DateOnly _rangeEnd;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var standingsTask = Http.GetFromJsonAsync<List<KboStandingDto>>("data/kbo-standings.json");
            var trendsTask = Http.GetFromJsonAsync<KboTeamTrendsDto>("data/kbo-team-trends.json");
            await Task.WhenAll(standingsTask, trendsTask);
            _standings = standingsTask.Result;
            _trends = trendsTask.Result;

            if (_trends is { Dates.Count: > 0 })
            {
                _minDate = DateOnly.Parse(_trends.Dates[0]);
                _maxDate = DateOnly.Parse(_trends.Dates[^1]);
                ResetRange();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void SwitchMetric(string metric) => _metric = metric;

    private void ResetRange()
    {
        _rangeEnd = _maxDate;
        var earliest = _rangeEnd.AddDays(-(DefaultRangeDays - 1));
        _rangeStart = earliest < _minDate ? _minDate : earliest;
    }

    private void OnRangeStartChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var d))
        {
            _rangeStart = d < _minDate ? _minDate : d;
            if (_rangeStart > _rangeEnd) _rangeEnd = _rangeStart;
        }
    }

    private void OnRangeEndChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var d))
        {
            _rangeEnd = d > _maxDate ? _maxDate : d;
            if (_rangeEnd < _rangeStart) _rangeStart = _rangeEnd;
        }
    }

    private List<int> RangeIndexes() => _trends is null
        ? new()
        : _trends.Dates
            .Select((date, i) => (date, i))
            .Where(x => DateOnly.TryParse(x.date, out var d) && d >= _rangeStart && d <= _rangeEnd)
            .Select(x => x.i)
            .ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var renderKey = $"{_metric}|{_rangeStart}|{_rangeEnd}";
        if (_trends is null || _chartRenderedFor == renderKey) return;
        _chartRenderedFor = renderKey;

        var series = GetSeries(_metric);
        // 경기가 없는 날(월요일/우천취소)은 스냅샷이 없어 전 팀 null — 그런 날짜는 x축에서 아예 제외한다
        var indexes = RangeIndexes()
            .Where(i => series.Any(t => i < t.Values.Count && t.Values[i] is not null))
            .ToList();
        var labels = indexes.Select(i => FormatDate(_trends.Dates[i])).ToArray();
        var datasets = series.Select(t => new
        {
            label = t.TeamName,
            data = indexes.Select(i => t.Values[i]).ToArray()
        }).ToArray();

        await JS.InvokeVoidAsync("albatrossCharts.renderLine", "standingsChart", labels, datasets);
    }

    private List<KboTeamTrendDto> GetSeries(string key) => key switch
    {
        "WinRate" => _trends!.WinRates,
        "Avg" => _trends!.Avgs,
        "Obp" => _trends!.Obps,
        "Era" => _trends!.Eras,
        "Oavg" => _trends!.Oavgs,
        _ => new()
    };

    private static string MetricLabel(string key) => key switch
    {
        "WinRate" => "승률",
        "Avg" => "팀타율",
        "Obp" => "팀출루율",
        "Era" => "팀방어율",
        "Oavg" => "팀피안타율",
        _ => key
    };

    private static bool IsLowerBetter(string key) => key is "Era" or "Oavg";

    private string ChartNote
    {
        get
        {
            var range = $"{_rangeStart:MM/dd}~{_rangeEnd:MM/dd}";
            return IsLowerBetter(_metric)
                ? $"{range} {MetricLabel(_metric)} 우수 팀(낮을수록 좋음)의 날짜별 추이"
                : $"{range} 팀별 {MetricLabel(_metric)} 추이 (날짜별 순위 변동 확인용)";
        }
    }

    private static string FormatDate(string isoDate) =>
        DateOnly.TryParse(isoDate, out var d) ? d.ToString("MM/dd") : isoDate;

    // <input type="date">의 value/min/max는 브라우저 로캘과 무관하게 항상 "yyyy-MM-dd" 형식이어야 한다 —
    // DateOnly를 그냥 보간하면 서버 컬처에 따라 다른 형식(en-US면 "M/d/yyyy" 등)으로 렌더링되어 깨진다.
    private static string IsoDate(DateOnly d) => d.ToString("yyyy-MM-dd");
}
