@page "/games"
@using System.Net.Http.Json
@using Albatross.Shared.Models
@using Microsoft.AspNetCore.Components
@inject HttpClient Http

<PageTitle>Albatross KBO - 날짜별 경기</PageTitle>


<h1 style="margin-bottom:1rem;">날짜별 경기</h1>

<div class="date-nav">
    <button @onclick="GoPrevDay" aria-label="이전 날짜">◀</button>
    <div class="current-date">@SelectedDate.ToString("yyyy.MM.dd (ddd)", _koreanCulture)</div>
    <button @onclick="GoNextDay" aria-label="다음 날짜">▶</button>
</div>

@if (_loading)
{
    <div class="loading"><div class="spinner"></div><p>불러오는 중...</p></div>
}
else if (_error is not null)
{
    <div class="error-box">데이터를 불러오지 못했습니다: @_error</div>
}
else
{
    var day = CurrentDay;

    @if (day is { Issues.Count: > 0 })
    {
        <div class="issue-card">
            <span class="label">오늘의 기록</span>
            <ul class="issue-list">
                @foreach (var issue in day.Issues)
                {
                    <li>@issue</li>
                }
            </ul>
        </div>
    }

    @if (day is null || day.Games.Count == 0)
    {
        <div class="empty">이 날짜에 수집된 경기 결과가 없습니다.</div>
    }
    else
    {
        <div class="game-grid">
            @foreach (var game in day.Games)
            {
                var awayWin = game.AwayScore.HasValue && game.HomeScore.HasValue && game.AwayScore > game.HomeScore;
                var homeWin = game.AwayScore.HasValue && game.HomeScore.HasValue && game.HomeScore > game.AwayScore;
                <div class="game-card">
                    <span class="time">@(game.GameTime ?? "")</span>
                    <div class="matchup">
                        <span class="team @(awayWin ? "winner" : "")">@game.AwayTeam</span>
                        <span class="score">@(game.AwayScore?.ToString() ?? "-") : @(game.HomeScore?.ToString() ?? "-")</span>
                        <span class="team @(homeWin ? "winner" : "")">@game.HomeTeam</span>
                    </div>
                </div>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(day?.Highlight))
    {
        <div class="highlight-box">
            <span class="label">AI 요약 (원문 재작성)</span>
            @day.Highlight
        </div>
    }
}

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "date")]
    public string? DateQuery { get; set; }

    private readonly System.Globalization.CultureInfo _koreanCulture = new("ko-KR");
    private List<KboGameDayDto>? _days;
    private Dictionary<string, KboGameDayDto> _daysByDate = new();
    private bool _loading = true;
    private string? _error;

    private DateOnly SelectedDate { get; set; } = DateOnly.FromDateTime(DateTime.Now);

    private KboGameDayDto? CurrentDay =>
        _daysByDate.TryGetValue(SelectedDate.ToString("yyyy-MM-dd"), out var d) ? d : null;

    protected override async Task OnInitializedAsync()
    {
        if (DateOnly.TryParse(DateQuery, out var fromQuery))
        {
            SelectedDate = fromQuery;
        }

        try
        {
            _days = await Http.GetFromJsonAsync<List<KboGameDayDto>>("data/kbo-games.json");
            _daysByDate = (_days ?? []).ToDictionary(d => d.GameDate);

            // 쿼리에 날짜가 없고 오늘 데이터도 없으면 가장 최근 수집된 날짜로 이동
            if (DateQuery is null && _days is { Count: > 0 } && CurrentDay is null)
            {
                var latest = _days.OrderByDescending(d => d.GameDate).First();
                if (DateOnly.TryParse(latest.GameDate, out var parsed))
                {
                    SelectedDate = parsed;
                }
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void GoPrevDay() => SelectedDate = SelectedDate.AddDays(-1);
    private void GoNextDay() => SelectedDate = SelectedDate.AddDays(1);
}
