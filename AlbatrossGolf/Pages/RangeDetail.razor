@page "/range/{Slug}"
@using System.Net.Http.Json
@using Albatross.Shared.Models
@inject HttpClient Http

<PageTitle>@(_range?.Name ?? "연습장") — Albatross Golf</PageTitle>

@if (_loading)
{
    <div class="loading"><div class="spinner"></div><p>불러오는 중...</p></div>
}
else if (_range is null)
{
    <div class="empty">연습장을 찾을 수 없습니다. <a href="">목록으로</a></div>
}
else
{
    <div class="section-nav">
        <a class="section-nav-parent" href="">⛳ 연습장 목록</a>
        <span class="section-nav-sep">›</span>
        <span class="section-nav-title">@_range.Name</span>
    </div>

    <h1 style="margin-bottom:0.3rem;">@_range.Name</h1>
    <div class="ex-meta" style="margin-bottom:1rem;">
        @if (!string.IsNullOrWhiteSpace(_range.Type)) { <span class="badge">@_range.Type</span> }
        @if (!string.IsNullOrWhiteSpace(_range.Region)) { <span class="badge badge--soft">@_range.Region</span> }
        @if (!string.IsNullOrWhiteSpace(_range.City)) { <span class="badge badge--soft">@_range.City</span> }
    </div>

    @if (!string.IsNullOrWhiteSpace(_range.Summary))
    {
        <p class="gym-lede">@_range.Summary</p>
    }

    <div class="tablewrap">
        <table class="data-table">
            <tbody>
                @if (!string.IsNullOrWhiteSpace(_range.Price)) { <tr><th>일일 타석 요금</th><td>@_range.Price</td></tr> }
                @if (!string.IsNullOrWhiteSpace(_range.LeftHanded)) { <tr><th>좌타석</th><td>@_range.LeftHanded</td></tr> }
                @if (!string.IsNullOrWhiteSpace(_range.DriverAllowed)) { <tr><th>드라이버 사용</th><td>@_range.DriverAllowed</td></tr> }
                @if (!string.IsNullOrWhiteSpace(_range.Parking)) { <tr><th>주차</th><td>@_range.Parking</td></tr> }
                @if (!string.IsNullOrWhiteSpace(_range.Hours)) { <tr><th>영업시간</th><td>@_range.Hours</td></tr> }
                @if (!string.IsNullOrWhiteSpace(_range.Address)) { <tr><th>주소</th><td>@_range.Address</td></tr> }
                @if (!string.IsNullOrWhiteSpace(_range.Phone)) { <tr><th>전화</th><td>@_range.Phone</td></tr> }
            </tbody>
        </table>
    </div>

    <AdSlot />

    @if (_range.Highlights.Count > 0)
    {
        <div class="ex-block">
            <h4>이런 점이 좋아요</h4>
            <ul class="ex-tips">
                @foreach (var h in _range.Highlights) { <li>@h</li> }
            </ul>
        </div>
    }

    @if (_range.Cautions.Count > 0)
    {
        <div class="ex-block">
            <h4>미리 알아두세요</h4>
            <ul class="ex-mistakes">
                @foreach (var c in _range.Cautions) { <li>@c</li> }
            </ul>
        </div>
    }

    @if (_range.SourceUrls.Count > 0)
    {
        <div class="ex-block">
            <h4>참고한 곳</h4>
            <ul class="ex-tips">
                @foreach (var url in _range.SourceUrls)
                {
                    <li><a href="@url" target="_blank" rel="noopener nofollow">@url</a></li>
                }
            </ul>
        </div>
    }

    <p class="muted-note">
        정보 기준: @(_range.UpdatedAt ?? "-") · 요금·운영 정책은 변경될 수 있으니 방문 전 확인하세요.
    </p>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private GolfRangeDto? _range;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var content = await Http.GetFromJsonAsync<GolfContentDto>("data/golf-ranges.json");
            _range = content?.Ranges.FirstOrDefault(r => r.Slug == Slug);
        }
        catch
        {
            _range = null;
        }
        finally
        {
            _loading = false;
        }
    }
}
