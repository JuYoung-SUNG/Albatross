@page "/"
@using System.Net.Http.Json
@using Albatross.Shared.Models
@inject HttpClient Http

<PageTitle>골프 연습장 정보 — Albatross Golf</PageTitle>

<h1 style="margin-bottom:0.3rem;">골프 연습장 찾기</h1>
<p class="gym-lede">파3·야외 인도어 연습장의 <b>요금 · 좌타석 · 드라이버 사용 · 주차</b> 정보를 한눈에 정리했습니다.</p>

@if (_loading)
{
    <div class="loading"><div class="spinner"></div><p>불러오는 중...</p></div>
}
else if (_error is not null)
{
    <div class="error-box">데이터를 불러오지 못했습니다: @_error</div>
}
else if (_ranges.Count == 0)
{
    <div class="empty">아직 등록된 연습장이 없습니다.</div>
}
else
{
    <div class="tab-row tab-row--sub">
        <button class="@(_region is null ? "active" : "")" @onclick="() => _region = null">전체 @_ranges.Count</button>
        @foreach (var region in Regions)
        {
            <button class="@(_region == region ? "active" : "")" @onclick="() => _region = region">@region</button>
        }
    </div>

    <div class="tab-row tab-row--sub">
        <button class="@(_type is null ? "active" : "")" @onclick="() => _type = null">모든 유형</button>
        @foreach (var type in Types)
        {
            <button class="@(_type == type ? "active" : "")" @onclick="() => _type = type">@type</button>
        }
    </div>

    <div class="tablewrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>연습장</th><th>지역</th><th>유형</th><th>요금</th><th>좌타석</th><th>드라이버</th><th>주차</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Filtered)
                {
                    <tr>
                        <td><a href="@($"range/{r.Slug}")" class="range-link">@r.Name</a></td>
                        <td>@r.City</td>
                        <td>@r.Type</td>
                        <td>@(r.Price ?? "-")</td>
                        <td>@(r.LeftHanded ?? "-")</td>
                        <td>@(r.DriverAllowed ?? "-")</td>
                        <td>@(r.Parking ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Filtered.Any())
    {
        <div class="empty">조건에 맞는 연습장이 없습니다.</div>
    }
}

@code {
    private static readonly string[] Regions = ["수도권", "강원", "충청", "영남", "호남", "제주"];
    private static readonly string[] Types = ["파3", "야외인도어", "실내", "스크린"];

    private List<GolfRangeDto> _ranges = new();
    private bool _loading = true;
    private string? _error;
    private string? _region;
    private string? _type;

    private IEnumerable<GolfRangeDto> Filtered =>
        _ranges.Where(r => (_region is null || r.Region == _region)
                        && (_type is null || r.Type == _type));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var content = await Http.GetFromJsonAsync<GolfContentDto>("data/golf-ranges.json");
            _ranges = content?.Ranges ?? new();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
